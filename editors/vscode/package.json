{
  "name": "bitview",
  "displayName": "bitview",
  "description": "Syntax highlighting, go to definition, references, and type hovers for bitview templates",
  "version": "0.8.0",
  "publisher": "nnenn0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nnenn0/bitview"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "files": [
    "extension.js",
    "language-configuration.json",
    "syntaxes/",
    "icons/"
  ],
  "activationEvents": [
    "onLanguage:bitview"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bitview",
        "aliases": [
          "bitview"
        ],
        "extensions": [
          ".bv"
        ],
        "icon": {
          "light": "./icons/bitview.svg",
          "dark": "./icons/bitview.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bitview",
        "scopeName": "source.bitview",
        "path": "./syntaxes/bitview.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[bitview]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    },
    "configuration": {
      "title": "bitview",
      "properties": {
        "bitview.typesCommand": {
          "type": "string",
          "default": "genbit types",
          "description": "The command that prints the types the host names for the templates, one declaration per paragraph. It runs in the directory that holds views/."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The host's types come from running bitview.typesCommand, which runs only in a trusted workspace.",
      "restrictedConfigurations": [
        "bitview.typesCommand"
      ]
    }
  }
}
