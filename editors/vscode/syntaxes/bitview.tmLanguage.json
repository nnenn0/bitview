{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "bitview",
  "scopeName": "source.bitview",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#definition"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#call"
    },
    {
      "include": "#type-name"
    },
    {
      "include": "#key"
    },
    {
      "include": "#field"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.semicolon.bitview",
      "match": ";.*$"
    },
    "string": {
      "name": "string.quoted.double.bitview",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.bitview"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.bitview"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.bitview",
          "match": "\\\\(?:[\\\"\\\\nt]|u\\{[0-9A-Fa-f]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.escape.bitview",
          "match": "\\\\."
        }
      ]
    },
    "definition": {
      "begin": "(\\()\\s*(defn-?)\\s+([a-z][a-z0-9]*(?:-[a-z0-9]+)*)\\s*(\\[)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.parens.bitview"
        },
        "2": {
          "name": "keyword.declaration.function.bitview"
        },
        "3": {
          "name": "entity.name.function.bitview"
        },
        "4": {
          "name": "punctuation.section.parameters.begin.bitview"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parameters.end.bitview"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#type"
        },
        {
          "name": "variable.parameter.bitview",
          "match": "(?<![A-Za-z0-9:.-])[a-z][a-z0-9]*(?:-[a-z0-9]+)*"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": "(\\()\\s*(if)(?![a-z0-9.-])",
          "captures": {
            "1": {
              "name": "punctuation.section.parens.bitview"
            },
            "2": {
              "name": "keyword.control.conditional.bitview"
            }
          }
        }
      ]
    },
    "call": {
      "patterns": [
        {
          "comment": "(map list function): the function is named, not called.",
          "match": "(\\()\\s*(map)\\s+([a-z][a-z0-9.-]*)\\s+([a-z][a-z0-9]*(?:-[a-z0-9]+)*)(?=\\s*\\))",
          "captures": {
            "1": {
              "name": "punctuation.section.parens.bitview"
            },
            "2": {
              "name": "support.function.builtin.bitview"
            },
            "3": {
              "patterns": [
                {
                  "include": "#field"
                }
              ]
            },
            "4": {
              "name": "entity.name.function.call.bitview"
            }
          }
        },
        {
          "match": "(\\()\\s*(html|head|body|title|meta|link|header|footer|main|nav|section|article|aside|h1|h2|h3|h4|h5|h6|p|div|ul|ol|li|dl|dt|dd|blockquote|pre|hr|a|span|time|strong|em|code|br|img|table|thead|tbody|tr|th|td)(?![a-z0-9.-])",
          "captures": {
            "1": {
              "name": "punctuation.section.parens.bitview"
            },
            "2": {
              "name": "entity.name.tag.bitview"
            }
          }
        },
        {
          "match": "(\\()\\s*(map|concat)(?![a-z0-9.-])",
          "captures": {
            "1": {
              "name": "punctuation.section.parens.bitview"
            },
            "2": {
              "name": "support.function.builtin.bitview"
            }
          }
        },
        {
          "match": "(\\()\\s*([a-z][a-z0-9]*(?:-[a-z0-9]+)*)(?![a-z0-9.-])",
          "captures": {
            "1": {
              "name": "punctuation.section.parens.bitview"
            },
            "2": {
              "name": "entity.name.function.call.bitview"
            }
          }
        }
      ]
    },
    "key": {
      "match": "(:)([a-z][a-z0-9]*(?:-[a-z0-9]+)*)",
      "captures": {
        "1": {
          "name": "punctuation.definition.keyword.bitview"
        },
        "2": {
          "name": "entity.other.attribute-name.bitview"
        }
      }
    },
    "field": {
      "match": "(\\.)([a-z][a-z0-9]*(?:-[a-z0-9]+)*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.bitview"
        },
        "2": {
          "name": "variable.other.property.bitview"
        }
      }
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.brackets.bitview",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.braces.bitview",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.bitview",
          "match": "[()]"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "include": "#type-name"
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.brackets.bitview"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.brackets.bitview"
            }
          },
          "patterns": [
            {
              "include": "#type"
            }
          ]
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.braces.bitview"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.braces.bitview"
            }
          },
          "patterns": [
            {
              "include": "#key"
            },
            {
              "include": "#type"
            }
          ]
        }
      ]
    },
    "type-name": {
      "name": "support.type.bitview",
      "match": "\\b[A-Z][A-Za-z0-9]*\\b"
    }
  }
}
